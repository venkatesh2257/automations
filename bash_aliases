# Custom Shell Aliases for Workhive Automation

# Workhive Work Log Commands
alias workhive='/home/user/Desktop/automation/workhive/run_worklog.sh'
alias logoff='/home/user/Desktop/automation/workhive/run_worklog.sh --poweroff'

# Master Automation Shortcut
alias auto-runall='/home/user/Desktop/automation/run_all.sh'
